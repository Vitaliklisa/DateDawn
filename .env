# Supabase connection settings for Date Dawn.
#
# This file is committed on purpose. It contains only the PUBLISHABLE key,
# which is designed to be public — Row Level Security is what protects the
# data, not the secrecy of this value.
#
# Never put the `sb_secret_...` key here. It bypasses Row Level Security
# entirely, and anything in this file ships inside the app binary where it can
# be extracted. The secret key belongs on a server, not in a client.
#
# A missing or empty value falls back to the constants in
# lib/supabase_config.dart, so the app still boots without this file.

SUPABASE_URL=https://wktilnzinqkelpjcwsqv.supabase.co
SUPABASE_ANON_KEY=sb_publishable_hommGM6hBArJ1GTGeqeQog_hrzpZrfQ
