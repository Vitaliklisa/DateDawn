  "supportCommonQuestions": "Häufige Fragen",
  "@supportCommonQuestions": {
    "description": "FAQ section heading on the support page."
  },
  "supportFaqGoogleQuestion": "Ich habe mich mit Google angemeldet und meine Countdowns fehlen.",
  "@supportFaqGoogleQuestion": {
    "description": "Support FAQ question about missing countdowns after Google sign-in."
  },
  "supportFaqGoogleAnswer": "Verwenden Sie dieselbe Anmeldemethode, die Sie bei der Erstellung Ihres Kontos genutzt haben. Google und E-Mail/Passwort werden nicht automatisch miteinander verknüpft. Wenn Sie die Methode wechseln oder vermuten, dass Daten in zwei Konten liegen, kontaktieren Sie uns, bevor Sie ein weiteres Konto erstellen.",
  "@supportFaqGoogleAnswer": {
    "description": "Support FAQ answer about account sign-in methods."
  },
  "supportFaqSharingQuestion": "Eine Person, mit der ich den Countdown geteilt habe, kann ihn nicht sehen.",
  "@supportFaqSharingQuestion": {
    "description": "Support FAQ question about a shared countdown."
  },
  "supportFaqSharingAnswer": "Beim Teilen eines Countdowns mit einem Kreis wird eine Einladung gesendet — Personen werden nicht automatisch hinzugefügt. Sie müssen Einladungen in der App öffnen und die Einladung annehmen. Ein Paar-Kreis ist die Ausnahme: Diese Freigabe erfolgt sofort.",
  "@supportFaqSharingAnswer": {
    "description": "Support FAQ answer about accepting countdown invitations."
  },
  "supportFaqDeclinedQuestion": "Ich habe versehentlich eine Einladung abgelehnt.",
  "@supportFaqDeclinedQuestion": {
    "description": "Support FAQ question about a declined invitation."
  },
  "supportFaqDeclinedAnswer": "Bitten Sie die einladende Person, Sie erneut einzuladen — dies ist im Countdown über das Aktualisierungssymbol neben Ihrem Namen möglich. In der Zwischenzeit geht nichts verloren.",
  "@supportFaqDeclinedAnswer": {
    "description": "Support FAQ answer about reopening an invitation."
  },
  "supportFaqDeleteQuestion": "Wie lösche ich mein Konto und meine Daten?",
  "@supportFaqDeleteQuestion": {
    "description": "Support FAQ question about deleting an account."
  },
  "supportFaqDeleteAnswer": "Schreiben Sie uns von der E-Mail-Adresse, mit der Sie sich registriert haben, und bitten Sie um Löschung. Jeder Countdown, jede Einladung und jede Benachrichtigung, die mit dem Konto verknüpft ist, wird entfernt; wir bestätigen Ihnen den Abschluss.",
  "@supportFaqDeleteAnswer": {
    "description": "Support FAQ answer about account deletion."
  },
  "supportFaqBlockQuestion": "Wie kann ich jemanden blockieren?",
  "@supportFaqBlockQuestion": {
    "description": "Support FAQ question about blocking a person."
  },
  "supportFaqBlockAnswer": "öffnen Sie einen Countdown, den Sie mit dieser Person teilen, halten Sie ihren Namen in der Personenliste lange gedrückt (oder klicken Sie auf einem Computer mit der rechten Maustaste). Die Person wird aus Ihren gemeinsam genutzten Countdowns entfernt und kann Sie nicht erneut einladen. Zum Rückgängigmachen öffnen Sie Einstellungen — Blockierte Personen.",
  "@supportFaqBlockAnswer": {
    "description": "Support FAQ answer about blocking and unblocking."
  },
  "supportFaqAdsQuestion": "Verkaufen Sie meine Daten oder zeigen Sie Werbung?",
  "@supportFaqAdsQuestion": {
    "description": "Support FAQ question about advertising and data."
  },
  "supportFaqAdsAnswer": "Nein. Es gibt keine Werbung, keine Analyseprofile und kein Tracking durch Drittanbieter. Ihre Countdowns sind ausschließlich Ihre Angelegenheit und werden in Ihrem Konto gespeichert, damit sie niemand anderes lesen kann.",
  "@supportFaqAdsAnswer": {
    "description": "Support FAQ answer about ads and data privacy."
  },
