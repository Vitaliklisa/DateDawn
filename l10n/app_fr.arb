  "supportCommonQuestions": "Questions fréquentes",
  "@supportCommonQuestions": {
    "description": "FAQ section heading on the support page."
  },
  "supportFaqGoogleQuestion": "Je me suis connecté avec Google et mes comptes à rebours ont disparu.",
  "@supportFaqGoogleQuestion": {
    "description": "Support FAQ question about missing countdowns after Google sign-in."
  },
  "supportFaqGoogleAnswer": "Utilisez la même méthode que celle que vous avez utilisée pour créer votre compte. Google et le mot de passe/e-mail ne sont pas liés automatiquement. Si vous devez changer de méthode ou pensez avoir des données dans deux comptes, contactez-nous avant de créer un autre compte.",
  "@supportFaqGoogleAnswer": {
    "description": "Support FAQ answer about account sign-in methods."
  },
  "supportFaqSharingQuestion": "Quelqu’un avec qui j’ai partagé ne voit pas le compte à rebours.",
  "@supportFaqSharingQuestion": {
    "description": "Support FAQ question about a shared countdown."
  },
  "supportFaqSharingAnswer": "Partager un compte à rebours avec un cercle envoie une invitation — cela ne rajoute pas les personnes automatiquement. Ils doivent ouvrir Invitations dans l’application et l’accepter. Un cercle de couple est la seule exception : il se partage instantanément.",
  "@supportFaqSharingAnswer": {
    "description": "Support FAQ answer about accepting countdown invitations."
  },
  "supportFaqDeclinedQuestion": "J’ai refusé une invitation par erreur.",
  "@supportFaqDeclinedQuestion": {
    "description": "Support FAQ question about a declined invitation."
  },
  "supportFaqDeclinedAnswer": "Demandez à la personne qui vous a invité de vous réinviter — elle peut le faire depuis le compte à rebours en appuyant sur l’icône d’actualisation à côté de votre nom. Rien n’est perdu entre-temps.",
  "@supportFaqDeclinedAnswer": {
    "description": "Support FAQ answer about reopening an invitation."
  },
  "supportFaqDeleteQuestion": "Comment supprimer mon compte et mes données ?",
  "@supportFaqDeleteQuestion": {
    "description": "Support FAQ question about deleting an account."
  },
  "supportFaqDeleteAnswer": "Envoyez-nous un e-mail depuis l’adresse avec laquelle vous vous êtes inscrit et demandez la suppression. Tous les comptes à rebours, invitations et notifications liés au compte sont supprimés, et nous confirmons quand c’est fait.",
  "@supportFaqDeleteAnswer": {
    "description": "Support FAQ answer about account deletion."
  },
  "supportFaqBlockQuestion": "Comment bloquer quelqu’un ?",
  "@supportFaqBlockQuestion": {
    "description": "Support FAQ question about blocking a person."
  },
  "supportFaqBlockAnswer": "Ouvrez un compte à rebours que vous partagez avec lui et appuyez longuement sur son nom dans la liste des personnes (clic secondaire sur un ordinateur). Il est retiré de vos comptes à rebours partagés et ne peut plus vous inviter à nouveau. Pour annuler, allez dans Paramètres → Personnes bloquées.",
  "@supportFaqBlockAnswer": {
    "description": "Support FAQ answer about blocking and unblocking."
  },
  "supportFaqAdsQuestion": "Vendez-vous mes données ou affichez-vous des publicités ?",
  "@supportFaqAdsQuestion": {
    "description": "Support FAQ question about advertising and data."
  },
  "supportFaqAdsAnswer": "Non. Il n’y a ni publicités, ni profils analytiques, ni suivi tiers. Ce que vous comptez n’appartient à personne d’autre que vous, donc il est stocké sous votre propre compte pour que personne d’autre ne puisse le lire.",
  "@supportFaqAdsAnswer": {
    "description": "Support FAQ answer about ads and data privacy."
  },
