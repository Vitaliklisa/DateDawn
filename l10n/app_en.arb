  "policyLastUpdated": "Last updated: February 2026 · Compliant with EU GDPR & Canada PIPEDA",
  "@policyLastUpdated": { "description": "Last-updated note at the top of the legal policy." },
  "privacyIntroTitle": "1. Introduction & Data Controller",
  "@privacyIntroTitle": { "description": "First privacy policy section heading." },
  "privacyIntroBody": "Date Dawn (\"we\", \"our\", or \"us\") respects your privacy and is committed to protecting your personal data. This Privacy Policy explains how we collect, use, and safeguard your information when you use our mobile and web applications, in full compliance with the EU General Data Protection Regulation (GDPR) and the Personal Information Protection and Electronic Documents Act (PIPEDA) of Canada.\n\nData Controller Contact: {supportEmail}",
  "@privacyIntroBody": { "description": "Introduction and data controller contact in the privacy policy.", "placeholders": { "supportEmail": { "type": "String" } } },
  "privacyCollectTitle": "2. Information We Collect",
  "@privacyCollectTitle": { "description": "Second privacy policy section heading." },
  "privacyCollectBody": "• Account Data: Email address and display name provided during authentication (Firebase Auth).\n• User Content: Countdowns, titles, dates, descriptions, and circle memberships you explicitly create or share.\n• Device & Notification Data: Push notification tokens to deliver countdown reminders and invitation alerts.\n\nWe do NOT collect browsing history, advertising identifiers, location data, or sell any personal information to third parties.",
  "@privacyCollectBody": { "description": "Information collected and not collected, as described in the privacy policy." },
  "privacyBasisTitle": "3. Legal Basis for Processing (EU GDPR)",
  "@privacyBasisTitle": { "description": "Third privacy policy section heading." },
  "privacyBasisBody": "We process your data under the following lawful bases:\n• Contractual Necessity: Providing countdown syncing, circle sharing, and invitation features.\n• Consent: When you grant push notification permissions or opt-in to shared circles.\n• Legitimate Interests: Ensuring application security, reliability, and preventing abuse.",
  "@privacyBasisBody": { "description": "Legal bases for processing personal data." },
  "privacySharingTitle": "4. Sharing & Blocking",
  "@privacySharingTitle": { "description": "Fourth privacy policy section heading." },
  "privacySharingBody": "Date Dawn lets people interact one-to-one: you can invite someone to a countdown, and both of you can leave notes on one you share. That content is visible only to the people on that countdown — never public, never shown to anyone else.\n\nYou can block another person at any time: open a countdown you share with them and long-press their name (or secondary-click it on desktop). Blocking removes you from each other’s countdowns, cancels invitations between you, and stops them inviting you again. The person is not told. The list of people you have blocked is private to you, and you can unblock anyone from Settings → Blocked people.",
  "@privacySharingBody": { "description": "Privacy policy explanation of sharing and blocking." },
  "privacyStorageTitle": "5. Data Storage & Security",
  "@privacyStorageTitle": { "description": "Fifth privacy policy section heading." },
  "privacyStorageBody": "Your data is securely stored and processed using Firebase (Google Cloud Platform) infrastructure adhering to high industry security standards. Data transmitted between your device and our servers is encrypted in transit using TLS.",
  "@privacyStorageBody": { "description": "Privacy policy explanation of data storage and security." },
  "privacyRightsTitle": "6. Your Rights (Access, Correction & Erasure)",
  "@privacyRightsTitle": { "description": "Sixth privacy policy section heading." },
  "privacyRightsBody": "Under GDPR and PIPEDA, you have the right to:\n• Access: Request a copy of the personal data we hold about you.\n• Rectification: Update or correct your profile information in Settings.\n• Erasure (Right to be Forgotten): Request complete deletion of your account and all associated countdowns and notifications at any time by contacting {supportEmail}.",
  "@privacyRightsBody": { "description": "User rights to access, correct, and erase personal data.", "placeholders": { "supportEmail": { "type": "String" } } },
  "termsAcceptanceTitle": "1. Acceptance of Terms",
  "@termsAcceptanceTitle": { "description": "First terms of service section heading." },
  "termsAcceptanceBody": "By accessing or using Date Dawn, you agree to be bound by these Terms of Service. If you do not agree to these terms, please do not use the application.",
  "@termsAcceptanceBody": { "description": "Terms of service acceptance section." },
  "termsUseTitle": "2. Use of the Service",
  "@termsUseTitle": { "description": "Second terms of service section heading." },
  "termsUseBody": "Date Dawn is provided for personal, non-commercial countdown and shared moment tracking. You agree not to misuse the service, upload malicious content, harass other users through shared circles or invitations, or attempt to bypass security controls.",
  "@termsUseBody": { "description": "Terms of service acceptable-use section." },
  "termsOwnershipTitle": "3. User Content & Ownership",
  "@termsOwnershipTitle": { "description": "Third terms of service section heading." },
  "termsOwnershipBody": "You retain all ownership rights to the countdown events, titles, and content you create. You grant Date Dawn a limited license solely to store and sync your content across your authenticated devices and shared circle members.",
  "@termsOwnershipBody": { "description": "Terms of service explanation of user content ownership." },
  "termsTerminationTitle": "4. Termination & Account Deletion",
  "@termsTerminationTitle": { "description": "Fourth terms of service section heading." },
  "termsTerminationBody": "You may stop using Date Dawn at any time and request account deletion by emailing support. We reserve the right to suspend or terminate accounts that violate these terms or abuse platform infrastructure.",
  "@termsTerminationBody": { "description": "Terms of service account termination and deletion section." },
  "termsLiabilityTitle": "5. Limitation of Liability",
  "@termsLiabilityTitle": { "description": "Fifth terms of service section heading." },
  "termsLiabilityBody": "Date Dawn is provided \"as is\" without warranties of any kind. We shall not be liable for any indirect, incidental, or consequential damages arising from your use of the application.",
  "@termsLiabilityBody": { "description": "Terms of service limitation of liability section." },
  "privacyPolicyTitle": "Privacy Policy",
