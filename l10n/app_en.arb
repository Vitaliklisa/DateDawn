  "termsOfServiceTitle": "Terms of Service",
  "@termsOfServiceTitle": { "description": "Title displayed on the terms of service page." },
  "supportHeading": "We read every message",
  "@supportHeading": { "description": "Heading on the help and support page." },
  "supportIntro": "Date Dawn is a small, independent app. Email is the fastest way to reach the person who builds it — there is no support desk in between. We usually reply {responseTime}.",
  "@supportIntro": { "description": "Introduction and expected response time on support page.", "placeholders": { "responseTime": { "type": "String" } } },
  "supportResponseTime": "within 2 business days",
  "@supportResponseTime": { "description": "Typical support email response time." },
  "supportCommonQuestions": "Common questions",
  "@supportCommonQuestions": { "description": "FAQ section heading on the support page." },
  "supportFaqGoogleQuestion": "I signed in with Google and my countdowns are missing.",
  "@supportFaqGoogleQuestion": { "description": "Support FAQ question about missing countdowns after Google sign-in." },
  "supportFaqGoogleAnswer": "Use the same method you used when you created your account. Google and email/password are not automatically linked. If you need to switch methods or think you have data in two accounts, contact us before creating another account.",
  "@supportFaqGoogleAnswer": { "description": "Support FAQ answer about account sign-in methods." },
  "supportFaqSharingQuestion": "Someone I shared with cannot see the countdown.",
  "@supportFaqSharingQuestion": { "description": "Support FAQ question about a shared countdown." },
  "supportFaqSharingAnswer": "Sharing a countdown with a circle sends an invitation — it does not add people automatically. They need to open Invitations in the app and accept it. A couple circle is the one exception: those share instantly.",
  "@supportFaqSharingAnswer": { "description": "Support FAQ answer about accepting countdown invitations." },
  "supportFaqDeclinedQuestion": "I declined an invitation by mistake.",
  "@supportFaqDeclinedQuestion": { "description": "Support FAQ question about a declined invitation." },
  "supportFaqDeclinedAnswer": "Ask the person who invited you to invite you again — they can do that from the countdown by tapping the refresh icon next to your name. Nothing is lost in the meantime.",
  "@supportFaqDeclinedAnswer": { "description": "Support FAQ answer about reopening an invitation." },
  "supportFaqDeleteQuestion": "How do I delete my account and my data?",
  "@supportFaqDeleteQuestion": { "description": "Support FAQ question about deleting an account." },
  "supportFaqDeleteAnswer": "Email us from the address you signed up with and ask for deletion. Every countdown, invitation and notification tied to the account is removed, and we confirm when it is done.",
  "@supportFaqDeleteAnswer": { "description": "Support FAQ answer about account deletion." },
  "supportFaqBlockQuestion": "How do I block someone?",
  "@supportFaqBlockQuestion": { "description": "Support FAQ question about blocking a person." },
  "supportFaqBlockAnswer": "Open a countdown you share with them and long-press their name in the people list (secondary-click on a computer). They are removed from your shared countdowns and cannot invite you again. To undo it, go to Settings → Blocked people.",
  "@supportFaqBlockAnswer": { "description": "Support FAQ answer about blocking and unblocking." },
  "supportFaqAdsQuestion": "Do you sell my data or show ads?",
  "@supportFaqAdsQuestion": { "description": "Support FAQ question about advertising and data." },
  "supportFaqAdsAnswer": "No. There are no ads, no analytics profiles and no third-party tracking. What you count down to is nobody's business but yours, so it is stored under your own account for nobody else to read.",
  "@supportFaqAdsAnswer": { "description": "Support FAQ answer about ads and data privacy." },
  "supportLegal": "Legal",
  "@supportLegal": { "description": "Legal links section heading on support page." },
