<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Themes for the Flutter Android shell.

      These must NOT reference `Theme.SplashScreen` or `Theme.AppCompat` — those
      live in libraries this app does not depend on, and AAPT fails the release
      build with "resource style/Theme.SplashScreen not found". Plain platform
      themes keep the app free of an AppCompat dependency it does not need.
    -->

    <!-- Shown while the process starts, before the Flutter engine draws its
         first frame. The dark canvas means no white flash on launch. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:forceDarkAllowed">false</item>
        <item name="android:windowFullscreen">false</item>
        <item name="android:windowDrawsSystemBarBackgrounds">false</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
    </style>

    <!-- Applied once the process has started: the colour behind the Flutter UI
         while it initialises and runs. -->
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">?android:colorBackground</item>
    </style>

    <!-- Referenced by AndroidManifest.xml. -->
    <style name="AppTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@color/colorPrimary</item>
        <item name="android:forceDarkAllowed">false</item>
    </style>
    <style name="AppTheme.NoActionBar" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:background">@null</item>
    </style>
    <!--
      Applied to MainActivity (see AndroidManifest.xml).

      `android:windowBackground` is the correct attribute here — NOT
      `android:background`. A theme's `android:background` is applied to the
      window's content view and is never cleared when Flutter attaches, so the
      launch bitmap stays painted over the Flutter surface forever: the app
      shows the splash and never draws a frame (FlutterRenderer logs
      "Width is zero. 0,0"). `windowBackground` is only the placeholder shown
      until the first Flutter frame, which is what we want.
    -->
    <style name="AppTheme.NoActionBarLaunch" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:forceDarkAllowed">false</item>
        <!--
          Do NOT add `android:background` here. A theme's `android:background`
          is applied to the window's content view and is never cleared when
          Flutter attaches, so the launch drawable stays painted over the Flutter
          surface and the app shows the splash forever without ever drawing a
          Dart frame.
        -->
    </style>
</resources>