rules_version = '2';

// Until — Firestore security rules.
//
// These are the authority: the Flutter client mirrors them so it can fail fast
// with a readable message, but nothing here trusts the client. Deploy with:
//
//   firebase deploy --only firestore:rules
//
// Shape:
//   events/{eventId}
//     ...fields..., deletedAt?
//     participants/{userId}   email, role, inviteStatus, joinedAt
//     notes/{noteId}          userId, text, createdAt, updatedAt
//   invitations/{inviteId}    eventId, invitedBy, inviteeEmail, role, status,
//                             createdAt, expiresAt, eventTitle
//   users/{userId}            email, displayName  (email lookup for invites)

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- helpers ----------

    function signedIn() {
      return request.auth != null;
    }

    function uid() {
      return request.auth.uid;
    }

    // The caller's email, lowercased. Firebase always stores it lowercased,
    // but normalising here keeps the invitation match exact.
    function myEmail() {
      return request.auth.token.email.lower();
    }

    function isParticipant(eventId) {
      return signedIn()
        && exists(/databases/$(database)/documents/events/$(eventId)/participants/$(uid()));
    }

    // Does a document exist once the whole batch has committed?
    //
    // The plain `exists()` sees the database as it was when the request started,
    // so it cannot see a sibling write from the same batch. `existsAfter()` can.
    // Needed wherever a rule has to verify something the same batch just wrote —
    // joining a circle writes the member row and the `memberIds` entry together,
    // and the rule for the second has to be able to see the first.
    function memberRowWritten(circleId) {
      return existsAfter(
        /databases/$(database)/documents/circles/$(circleId)/members/$(uid())
      );
    }

    function participantRole(eventId) {
      return get(/databases/$(database)/documents/events/$(eventId)/participants/$(uid())).data.role;
    }

    // Membership of a circle, checked against the denormalised `memberIds`
    // array so it costs one document read rather than a subcollection query.
    function isCircleMember(circleId) {
      return signedIn()
        && circleId != null
        && circleId in get(/databases/$(database)/documents/circles/$(circleId)).data.memberIds;
    }

    // True when the event is shared with any circle this user belongs to.
    // `eventCircles` is a list; rules have no loop, so the client sends the
    // checked list back and we verify membership for each entry.
    function isSharedWithMyCircle(circleIds) {
      return signedIn()
        && circleIds != null
        && circleIds.size() > 0
        && circleIds[0] is string
        && isCircleMember(circleIds[0]);
    }

    // Creator, accepted participant, or a member of a circle it was shared with.
    function canRead(eventId, data) {
      return signedIn()
        && (
          data.createdBy == uid()
          || (
            isParticipant(eventId)
            && get(/databases/$(database)/documents/events/$(eventId)/participants/$(uid())).data.inviteStatus == 'accepted'
          )
          || (
            data.sharedWithCircleIds != null
            && data.sharedWithCircleIds.size() > 0
            && isCircleMember(data.sharedWithCircleIds[0])
          )
        );
    }

    function isAdmin(eventId) {
      return signedIn() && isParticipant(eventId) && participantRole(eventId) == 'admin';
    }

    // The same question as `isAdmin`, asked of the database as of the end of the
    // batch. Use this whenever the admin row may be written by the same request
    // that needs to prove it — creating a countdown writes the event and its
    // creator's admin row together, then invites people to it.
    function isAdminAfter(eventId) {
      return signedIn()
        && existsAfter(/databases/$(database)/documents/events/$(eventId)/participants/$(uid()))
        && getAfter(/databases/$(database)/documents/events/$(eventId)/participants/$(uid())).data.role == 'admin';
    }

    function isEditor(eventId) {
      return signedIn()
        && isParticipant(eventId)
        && participantRole(eventId) in ['admin', 'editor'];
    }

    function isOwner(eventId, data) {
      return signedIn() && data.createdBy == uid();
    }

    // Only the fields the editor is allowed to touch may change.
    function onlyEventFieldsChanged() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(['title', 'description', 'at', 'updatedAt', 'deletedAt', 'sharedWithCircleIds', 'circleId']);
    }

    function validEventPayload() {
      return request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 80
        && request.resource.data.description is string
        && request.resource.data.description.size() <= 280
        && request.resource.data.at is timestamp
        && request.resource.data.createdBy == uid();
    }

    // ---------- users ----------
    //
    // A tiny public profile per account. It exists so an inviter can turn an
    // email address into a uid when adding someone straight to a countdown.
    // Only the email and display name are readable, and only to signed-in
    // users — never the whole auth record.
    //
    // The same document also carries per-user settings (`themeMode`) and owns
    // the notification inbox below, so a user must be able to write their own.
    match /users/{userId} {
      allow read: if signedIn();
      allow create, update: if signedIn() && userId == uid();
      allow delete: if false;

      // ---------- notifications ----------
      //
      // The in-app inbox, one subcollection per user. Living under the owner's
      // document means the path itself carries the recipient, so no rule has
      // to trust a `userId` field on the document — a query cannot span users
      // even by mistake.
      //
      // Read/update/delete: only the owner. Create: any signed-in user, because
      // "your friend joined your circle" is written by the friend, not by the
      // recipient. The create is still constrained to a well-formed document so
      // it cannot be used as arbitrary storage.
      match /notifications/{notificationId} {
        allow read, update, delete: if signedIn() && userId == uid();

        allow create: if signedIn()
          && request.resource.data.title is string
          && request.resource.data.title.size() > 0
          && request.resource.data.title.size() <= 120
          && request.resource.data.body is string
          && request.resource.data.body.size() <= 500
          && request.resource.data.type in ['invitation', 'circle', 'system', 'reminder']
          && request.resource.data.read == false;

        // The owner may only flip `read`; nothing else is theirs to change.
        allow update: if signedIn()
          && userId == uid()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
      }
    }

    // ---------- events ----------
    match /events/{eventId} {
      allow read: if canRead(eventId, resource.data);
      // Creating is unrestricted for a signed-in user, provided they name
      // themselves as the creator.
      allow create: if signedIn() && validEventPayload();

      allow update: if (isOwner(eventId, resource.data) || isEditor(eventId))
        && onlyEventFieldsChanged();

      // Soft delete only: a hard delete would orphan participants and notes.
      allow delete: if false;

      // ---------- participants ----------
      match /participants/{userId} {
        // Participants are visible to anyone who can see the event.
        allow read: if signedIn()
          && (isParticipant(eventId) || isOwner(eventId, get(/databases/$(database)/documents/events/$(eventId)).data));

        // The creator seeds their own admin row as part of creating the event.
        // Everyone else is added by an admin, or by accepting an invitation.
        allow create: if signedIn()
          && (
            userId == uid()
            || isAdmin(eventId)
            || isOwner(eventId, get(/databases/$(database)/documents/events/$(eventId)).data)
            || getAfter(/databases/$(database)/documents/events/$(eventId)).data.createdBy == request.auth.uid
          );

        // An invitee may flip their OWN row from pending to accepted — that is
        // what accepting an invitation does — but may not change their role.
        allow update: if signedIn()
          && (
            isAdmin(eventId)
            || isOwner(eventId, get(/databases/$(database)/documents/events/$(eventId)).data)
            || (
              userId == uid()
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['inviteStatus'])
              && request.resource.data.inviteStatus == 'accepted'
            )
          );

        allow delete: if signedIn()
          && (
            isAdmin(eventId)
            || isOwner(eventId, get(/databases/$(database)/documents/events/$(eventId)).data)
          );
      }

      // ---------- notes ----------
      match /notes/{noteId} {
        allow read: if signedIn()
          && (isParticipant(eventId) || isOwner(eventId, get(/databases/$(database)/documents/events/$(eventId)).data));

        allow create: if signedIn()
          && request.resource.data.userId == uid()
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 2000
          && (isParticipant(eventId) || isOwner(eventId, get(/databases/$(database)/documents/events/$(eventId)).data));

        // You may edit or remove your own note. Admins may remove any note.
        allow update, delete: if signedIn()
          && (
            resource.data.userId == uid()
            || isAdmin(eventId)
            || isOwner(eventId, get(/databases/$(database)/documents/events/$(eventId)).data)
          );
      }
    }

    // ---------- invitations ----------
    match /invitations/{inviteId} {
      // An invitation is readable by the person who sent it and the person it
      // is addressed to — nobody else.
      allow read: if signedIn()
        && (resource.data.invitedBy == uid() || resource.data.inviteeEmail == myEmail());

      allow create: if signedIn()
        && request.resource.data.invitedBy == uid()
        && request.resource.data.inviteeEmail is string
        && request.resource.data.inviteeEmail == request.resource.data.inviteeEmail.lower()
        && request.resource.data.status == 'pending'
        // Only an admin of the target event may invite to it.
        //
        // Resolved with `getAfter`, not `get`. A plain `get()` sees the database
        // as it was when the request started, so it cannot find the event or the
        // participant row when both are written by the *same batch* — which is
        // exactly how a countdown invites the people it was shared with. With
        // `get()` this condition was false for every invitation in that batch,
        // and Firestore rejected the whole thing: "Firestore refused the save".
        // `getAfter()` resolves as of the end of the batch and finds both.
        && (isAdminAfter(request.resource.data.eventId)
          || getAfter(/databases/$(database)/documents/events/$(request.resource.data.eventId)).data.createdBy == uid());

      // The invitee may accept or decline. The sender may cancel.
      allow update: if signedIn()
        && (
          (
            resource.data.inviteeEmail == myEmail()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
            && request.resource.data.status in ['accepted', 'rejected']
          )
          || (
            resource.data.invitedBy == uid()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
          )
        );

      allow delete: if signedIn() && resource.data.invitedBy == uid();
    }

    // ---------- circles ----------
    //
    // A circle is a standing group. Membership is the whole permission model:
    // you can see a circle (and the countdowns shared with it) if your uid is
    // in `memberIds`.
    match /circles/{circleId} {
      allow read: if signedIn()
        && uid() in resource.data.memberIds;

      allow create: if signedIn()
        && request.resource.data.ownerId == uid()
        && request.resource.data.memberIds == [uid()]
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 60;

      // The owner may rename or change the emoji. A member may only touch
      // `memberIds`, and only by adding or removing their own uid — that covers
      // joining by invitation and leaving, and nothing else.
      //
      // Rules have no loop, so the two allowed shapes are checked explicitly
      // rather than "the diff is exactly my uid":
      //   join  -> new list = old list + me
      //   leave -> new list = old list - me
      //
      // The join shape reads `getAfter`, not `resource`.
      //
      // `resource.data` is the state of the document **as it is committed in the
      // same batch as this write**, and the client's acceptCircleInvitation
      // batch commits the membership subcollection write first. `getAfter`
      // resolves a document as of the end of the whole batch, so it sees the
      // member row the batch just wrote; `resource.data` does not. Testing the
      // subcollection against `resource.data` is therefore always false on the
      // only path that ever adds a member this way — which is exactly the
      // `permission-denied` a new member used to get on Accept, with the circle
      // document left untouched and the membership row half-written.
      //
      // The `memberIds` diff is still computed against `resource.data`: that is
      // what actually protects against a non-owner granting themselves access,
      // and it stays exactly as strict as before.
      allow update: if signedIn()
        && (
          (resource.data.ownerId == uid()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'emoji', 'memberIds']))
          || (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberIds'])
            && (
              (request.resource.data.memberIds.size() == resource.data.memberIds.size() + 1
                && uid() in request.resource.data.memberIds
                && !(uid() in resource.data.memberIds)
                && memberRowWritten(circleId))
              || (request.resource.data.memberIds.size() == resource.data.memberIds.size() - 1
                && !(uid() in request.resource.data.memberIds)
                && uid() in resource.data.memberIds)
            )
          )
        );

      allow delete: if signedIn() && resource.data.ownerId == uid();

      // Members of the circle, with names and avatars for the UI.
      match /members/{userId} {
        allow read: if signedIn()
          && uid() in get(/databases/$(database)/documents/circles/$(circleId)).data.memberIds;

        // You add yourself (accepting an invitation). Only the circle owner may
        // add someone else, which is what a couple auto-share does.
        allow create, update: if signedIn()
          && (
            userId == uid()
            || get(/databases/$(database)/documents/circles/$(circleId)).data.ownerId == uid()
          );

        allow delete: if signedIn()
          && (
            userId == uid()
            || get(/databases/$(database)/documents/circles/$(circleId)).data.ownerId == uid()
          );
      }
    }

    // ---------- circle invitations ----------
    match /circle_invitations/{inviteId} {
      // Readable by the sender and the invited email — nobody else. The invitee
      // is not a member yet, so this cannot be a membership check.
      allow read: if signedIn()
        && (
          resource.data.invitedBy == uid()
          || resource.data.inviteeEmail == request.auth.token.email.lower()
        );

      allow create: if signedIn()
        && request.resource.data.invitedBy == uid()
        && request.resource.data.inviteeEmail is string
        && request.resource.data.inviteeEmail == request.resource.data.inviteeEmail.lower()
        && request.resource.data.status == 'pending'
        // Only the owner of the target circle may invite into it.
        && get(/databases/$(database)/documents/circles/$(request.resource.data.circleId)).data.ownerId == uid();

      // The invitee answers; the sender may cancel.
      allow update: if signedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && (
          resource.data.inviteeEmail == request.auth.token.email.lower()
          || resource.data.invitedBy == uid()
        );

      allow delete: if signedIn() && resource.data.invitedBy == uid();
    }

    // ---------- invitation responses ----------
    //
    // One-way feedback: "your friend joined" / "your friend declined". Only the
    // recipient reads them, and only the responder's own action creates one, so
    // a user cannot forge an answer on someone else's behalf.
    match /responses/{responseId} {
      allow read: if signedIn() && resource.data.recipientId == uid();

      allow create: if signedIn()
        && request.resource.data.recipientId is string
        && request.resource.data.responderEmail == request.auth.token.email.lower()
        && request.resource.data.accepted is bool
        && request.resource.data.read == false;

      // Only the recipient may mark it read.
      allow update: if signedIn()
        && resource.data.recipientId == uid()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);

      allow delete: if signedIn() && resource.data.recipientId == uid();
    }

    // Everything not matched above is denied.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
